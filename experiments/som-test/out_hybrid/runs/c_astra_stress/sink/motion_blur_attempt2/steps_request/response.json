    {
      "id": "msg_0817000c15fe0dec016ad37765777487d291cdffa92b85f232",
      "content": [
        {
          "annotations": [],
          "text": "{\n  \"steps\": [\n    {\n      \"title\": \"დაკეტე წყალი\",\n      \"text\": \"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\n      \"focus\": [\"p2\", \"p3\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p2\", \"label\": \"პირველი ჩამკეტი\", \"tone\": \"brand\"},\n        {\"part\": \"p3\", \"label\": \"მეორე ჩამკეტი\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [\n        {\"part\": \"p2\", \"type\": \"rotate\", \"dir\": \"cw\"},\n        {\"part\": \"p3\", \"type\": \"rotate\", \"dir\": \"cw\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"დაკეტე ნაზად; თუ სარქველი გაჭედილია, ძალას ნუ დაატან.\"\n    },\n    {\n      \"title\": \"ჩადგი ვედრო სიფონის ქვეშ\",\n      \"text\": \"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\n      \"focus\": [],\n      \"avoid\": [],\n      \"markers\": [],\n      \"arrows\": [],\n      \"tools\": [\"ვედრო ან ღრმა თასი\"],\n      \"warn\": \"ვედრო ან თასი ფოტოზე და ნაწილების სიაში არ ჩანს, ამიტომ დასადგმელ ნივთს ID ვერ მიენიჭება.\"\n    },\n    {\n      \"title\": \"მოუშვი ქანჩი\",\n      \"text\": \"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\n      \"focus\": [\"p4\"],\n      \"avoid\": [\"p2\", \"p3\"],\n      \"markers\": [\n        {\"part\": \"p4\", \"label\": \"სავარაუდო სამიზნე ქანჩი\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [\n        {\"part\": \"p4\", \"type\": \"rotate\", \"dir\": \"ccw\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"ფოტო ბუნდოვანია: წვეთები ან სველი კვალი მკაფიოდ არ ჩანს. p4 შერჩეულია დაშვებით, რადგან უშუალოდ სიფონის მოსახსნელ მუხლს უერთდება; p1-იც შესაძლო კანდიდატია. გაჟონვის წყარო გახსნამდე გადაამოწმე. ბრუნვის მიმართულება იგულისხმება ქანჩის მხრიდან შეერთებისკენ ყურებისას.\"\n    },\n    {\n      \"title\": \"შეამოწმე შუასადები\",\n      \"text\": \"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\n      \"focus\": [\"p5\"],\n      \"avoid\": [\"p2\", \"p3\"],\n      \"markers\": [\n        {\"part\": \"p5\", \"label\": \"მოსახსნელი სიფონი\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [\"შესაბამისი ზომის ახალი შუასადები საჭიროების შემთხვევაში\"],\n      \"warn\": \"შიდა რეზინის რგოლი უხილავია და ID არ აქვს; focus აღნიშნავს მხოლოდ მოსახსნელ სიფონს. თუ მუხლი არ თავისუფლდება, ძალით ნუ მოქაჩავ — შეამოწმე სხვა დამჭერი შეერთებაც. 40 მმ მოცემულია ინსტრუქციაში და ფოტოთი არ დასტურდება; ზომა და პროფილი ძველ შუასადებს შეადარე.\"\n    },\n    {\n      \"title\": \"მოუჭირე და შეამოწმე\",\n      \"text\": \"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\n      \"focus\": [\"p4\", \"p2\", \"p3\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p4\", \"label\": \"მოჭერა და გაჟონვის შემოწმება\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [\n        {\"part\": \"p4\", \"type\": \"rotate\", \"dir\": \"cw\"},\n        {\"part\": \"p2\", \"type\": \"rotate\", \"dir\": \"ccw\"},\n        {\"part\": \"p3\", \"type\": \"rotate\", \"dir\": \"ccw\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"p4 კვლავ დაშვებითაა არჩეული. დამატებითი მეოთხედი ბრუნი უნივერსალური წესი არ არის: პლასტმასა არ გადაჭიმო და დაიცავი მწარმოებლის მითითება. გახსენი ჩამკეტები ნელა, შემდეგ ნიჟარის ონკანიდან გაუშვი წყალი სიფონის შესამოწმებლად; ნიჟარის ონკანი ფოტოზე არ ჩანს.\"\n    }\n  ],\n  \"unknown_parts\": [\n    \"ვედრო ან ღრმა თასი — ფოტოზე არ ჩანს.\",\n    \"ქანჩის შიგნით რეზინის შუასადები — აწყობილ შეერთებაში უხილავია.\",\n    \"ნიჟარის ონკანი — ფოტოზე და ნაწილების სიაში არ ჩანს.\"\n  ]\n}",
          "type": "output_text",
          "logprobs": []
        }
      ],
