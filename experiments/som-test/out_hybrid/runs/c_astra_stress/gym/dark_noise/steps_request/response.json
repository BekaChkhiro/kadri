          "annotations": [],
          "text": "{\n  \"steps\": [\n    {\n      \"title\": \"დაარეგულირე სიმაღლე\",\n      \"text\": \"გამოსწიე ყვითელი ღილაკი სავარძლის ქვეშ და ისე დააყენე, რომ ჯდომისას მუხლები ბალიშების ქვეშ მჭიდროდ მოექცეს.\",\n      \"focus\": [\"p6\", \"p5\"],\n      \"avoid\": [\"p2\"],\n      \"markers\": [\n        {\"part\": \"p6\", \"label\": \"სიმაღლის რეგულირება\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [\n        {\"part\": \"p6\", \"type\": \"move\", \"dir\": \"toward\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"რეგულირება შეასრულე დაუტვირთავ სავარძელზე; დაჯდომამდე დარწმუნდი, რომ ღილაკი ჩაჯდა და სავარძელი დაფიქსირდა.\"\n    },\n    {\n      \"title\": \"აირჩიე წონა\",\n      \"text\": \"ყვითელი ქინძისთავი გადაიტანე სასურველ ფილაში და ბოლომდე ჩაარჭე.\",\n      \"focus\": [\"p2\"],\n      \"avoid\": [\"p6\"],\n      \"markers\": [\n        {\"part\": \"p2\", \"label\": \"წონის ქინძისთავი\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"წონა შეცვალე მხოლოდ მაშინ, როცა ფილები სრულად დაშვებულია. დაიწყე მსუბუქი დატვირთვით.\"\n    },\n    {\n      \"title\": \"მოკიდე სახელურს\",\n      \"text\": \"ფეხზე მდგომმა მოკიდე ხელი მოხრილ ბოლოებთან, მხრებზე ოდნავ ფართოდ, ხელისგულები წინ.\",\n      \"focus\": [\"p1\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p1\", \"label\": \"მოჭიდება მოხრილ ბოლოებთან\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": null\n    },\n    {\n      \"title\": \"დაჯექი და დაფიქსირდი\",\n      \"text\": \"სახელურით ხელში დაჯექი, ფეხები იატაკზე, მუხლები ბალიშების ქვეშ. მკერდი წინ, ზურგი სწორი.\",\n      \"focus\": [\"p5\", \"p3\", \"p4\", \"p1\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p5\", \"label\": \"დაჯექი\", \"tone\": \"brand\"},\n        {\"part\": \"p3\", \"label\": \"მუხლი ბალიშის ქვეშ\", \"tone\": \"neutral\"},\n        {\"part\": \"p4\", \"label\": \"მუხლი ბალიშის ქვეშ\", \"tone\": \"neutral\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"სახელური მყარად გეჭიროს და დაჯექი კონტროლირებულად.\"\n    },\n    {\n      \"title\": \"ჩამოწიე მკერდამდე\",\n      \"text\": \"იდაყვები ქვემოთ და უკან, სახელური მკერდის ზედა ნაწილამდე. ზემოთ ნელა აუშვი, 2 წამში.\",\n      \"focus\": [\"p1\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p1\", \"label\": \"ჩამოწიე კონტროლირებულად\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [\n        {\"part\": \"p1\", \"type\": \"move\", \"dir\": \"down\"},\n        {\"part\": \"p1\", \"type\": \"move\", \"dir\": \"up\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"არ ჩამოქაჩო კისრის უკან და არ გამოიყენო სხეულის ქანაობა. ტკივილის შემთხვევაში შეწყვიტე მოძრაობა; 2 წამი ინსტრუქციის ტემპია და არა ფოტოდან დადგენილი მონაცემი.\"\n    }\n  ],\n  \"unknown_parts\": []\n}",
