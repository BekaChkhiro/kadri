      "content": [
        {
          "annotations": [],
          "text": "{\n  \"steps\": [\n    {\n      \"title\": \"ჩართე განათება\",\n      \"text\": \"დააჭირე ჩამრთველს ფუძეზე. შუქი მაგიდის ქვემოდან უნდა ანთოს.\",\n      \"focus\": [\"p13\"],\n      \"avoid\": [],\n      \"markers\": [{\"part\": \"p13\", \"label\": \"განათების ჩამრთველი\", \"tone\": \"brand\"}],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"ფოტოზე განათება უკვე ანთებულია; თუ ის ჩართულია, ჩამრთველს ხელახლა ნუ დააჭერ.\"\n    },\n    {\n      \"title\": \"დააყენე 4× ობიექტივი\",\n      \"text\": \"მოატრიალე რევოლვერი, სანამ ყველაზე მოკლე ობიექტივი ქვემოთ არ დადგება და არ დაიწკაპუნებს.\",\n      \"focus\": [\"p4\", \"p3\"],\n      \"avoid\": [\"p7\"],\n      \"markers\": [{\"part\": \"p3\", \"label\": \"სავარაუდო 4× ობიექტივი\", \"tone\": \"brand\"}],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"მარჯვნივ მდებარე p3 ყველაზე მოკლედ ჩანს, ამიტომ 4×-ის სავარაუდო კანდიდატია; გადიდების წარწერა ფოტოზე არ იკითხება. გადაამოწმე ობიექტივის მარკირება და რევოლვერი ისე მოატრიალე, რომ ობიექტივი მინას არ შეეხოს.\"\n    },\n    {\n      \"title\": \"დადე პრეპარატი\",\n      \"text\": \"მინა დადე მაგიდაზე ისე, რომ ნიმუში ზუსტად ნახვრეტის თავზე იყოს, და ორივე სამაგრით დაამაგრე.\",\n      \"focus\": [\"p7\", \"p9\", \"p6\", \"p8\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p7\", \"label\": \"საგნობრივი მინა\", \"tone\": \"brand\"},\n        {\"part\": \"p6\", \"label\": \"მარცხენა სამაგრი\", \"tone\": \"neutral\"},\n        {\"part\": \"p8\", \"label\": \"მარჯვენა სამაგრი\", \"tone\": \"neutral\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"ფოტოზე მინა უკვე დევს მაგიდაზე. გადაამოწმე ნიმუშის ცენტრირება და მინა სამაგრებით ფრთხილად დაამაგრე.\"\n    },\n    {\n      \"title\": \"იპოვე გამოსახულება\",\n      \"text\": \"ოკულარში იყურე და დიდი ხრახნი ნელა ატრიალე, სანამ გამოსახულება არ გამოჩნდება.\",\n      \"focus\": [\"p1\", \"p11\"],\n      \"avoid\": [\"p7\"],\n      \"markers\": [{\"part\": \"p11\", \"label\": \"დიდი ფოკუსირების ხრახნი\", \"tone\": \"brand\"}],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"დიდი ხრახნი გამოიყენე მხოლოდ დადასტურებულ დაბალ გადიდებაზე. გვერდიდან აკონტროლე ობიექტივსა და მინას შორის დაშორება, რათა შეჯახება აიცილო.\"\n    },\n    {\n      \"title\": \"გადადი 40×-ზე\",\n      \"text\": \"ჩართე 40× ობიექტივი და სიმკვეთრე მხოლოდ პატარა ხრახნით დაარეგულირე, ნახევარი ბრუნით.\",\n      \"focus\": [\"p4\", \"p5\", \"p10\"],\n      \"avoid\": [\"p11\", \"p7\"],\n      \"markers\": [\n        {\"part\": \"p5\", \"label\": \"სავარაუდო 40× ობიექტივი\", \"tone\": \"brand\"},\n        {\"part\": \"p10\", \"label\": \"მხოლოდ წვრილი ფოკუსირება\", \"tone\": \"brand\"},\n        {\"part\": \"p11\", \"label\": \"არ გამოიყენო 40×-ზე\", \"tone\": \"danger\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"ცენტრალური, ყველაზე გრძელი p5 სავარაუდოდ 40× ობიექტივია, მაგრამ მისი მარკირება ფოტოზე არ იკითხება — გამოყენებამდე გადაამოწმე. ნახევარი ბრუნი მოცემული ინსტრუქციაა და არა ფოტოთი დადასტურებული საჭიროება; პატარა ხრახნი მცირე მოძრაობებით ატრიალე და სიმკვეთრის მიღებისთანავე გაჩერდი.\"\n    }\n  ],\n  \"unknown_parts\": []\n}",
