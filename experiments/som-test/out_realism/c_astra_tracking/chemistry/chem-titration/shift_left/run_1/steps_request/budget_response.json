          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"შეავსე ბიურეტი\",\"text\":\"ონკანი დახურულია? ძაბრით ჩაასხი ტიტრანტი ნულოვან ნიშნულზე ოდნავ მაღლა.\",\"focus\":[\"p3\",\"p1\",\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p3\",\"label\":\"შეამოწმე, რომ დახურულია\",\"tone\":\"neutral\"},{\"part\":\"p1\",\"label\":\"აქ ჩაასხი ტიტრანტი\",\"tone\":\"brand\"}],\"arrows\":[],\"tools\":[\"ტიტრანტი\"],\"warn\":\"ფოტოდან ონკანის დახურული მდგომარეობა და ნულოვანი ნიშნული ვერ დასტურდება. გამოიყენე შესაბამისი დამცავი სათვალე და ხელთათმანები.\"},{\"title\":\"მოხსენი ძაბრი\",\"text\":\"ძაბრი ტიტრაციამდე აუცილებლად მოხსენი. მისგან ჩამოსული წვეთები მოცულობას გააფუჭებს.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"მოხსენი ძაბრი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"up\"}],\"tools\":[],\"warn\":null},{\"title\":\"წაიკითხე საწყისი მოცულობა\",\"text\":\"თვალი სითხის დონეზე დაიჭირე და წაიკითხე მენისკის ქვედა კიდე. ჩაიწერე ჟურნალში.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"მენისკის ქვედა კიდე\",\"tone\":\"brand\"}],\"arrows\":[],\"tools\":[\"ჟურნალი\",\"კალამი\"],\"warn\":\"ფოტოდან ზუსტი მოცულობა არ იკითხება; მაჩვენებელი უშუალოდ ბიურეტის სკალაზე წაიკითხე.\"},{\"title\":\"დაამატე ინდიკატორი\",\"text\":\"კოლბაში ჩააწვეთე 2–3 წვეთი ფენოლფთალეინი და დადე თეთრ ფილაზე ონკანის ქვეშ.\",\"focus\":[\"p6\",\"p5\",\"p7\"],\"avoid\":[\"p4\"],\"markers\":[{\"part\":\"p6\",\"label\":\"სავარაუდო ინდიკატორის ბოთლი\",\"tone\":\"neutral\"},{\"part\":\"p5\",\"label\":\"აქ დაამატე ინდიკატორი\",\"tone\":\"brand\"},{\"part\":\"p7\",\"label\":\"კოლბის დასადგმელი ფილა\",\"tone\":\"brand\"}],\"arrows\":[],\"tools\":[\"ფენოლფთალეინი\"],\"warn\":\"მარცხენა საწვეთურიანი ბოთლი p6 სავარაუდო წყაროა, მაგრამ მისი შიგთავსი ფოტოთი არ დასტურდება — გადაამოწმე ეტიკეტი. 2–3 წვეთი ინსტრუქციის დოზაა და არა ფოტოდან დადგენილი. კოლბა უკვე ფილაზე დგას; გადაადგილებისას არ შეეხო ბიურეტის წვერს.\"},{\"title\":\"ტიტრაცია\",\"text\":\"ონკანი ნელა გახსენი და კოლბა წრიულად ატრიალე. გაჩერდი, როცა ღია ვარდისფერი 30 წამს შენარჩუნდება.\",\"focus\":[\"p3\",\"p5\"],\"avoid\":[\"p4\"],\"markers\":[{\"part\":\"p3\",\"label\":\"ნელა გახსენი\",\"tone\":\"brand\"},{\"part\":\"p5\",\"label\":\"ფრთხილად ატრიალე წრიულად\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p5\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[\"ტაიმერი\"],\"warn\":\"ონკანის გახსნის მიმართულება ფოტოდან არ დასტურდება. კოლბის წრიული მოძრაობის მიმართულება პირობითია; არ მიარტყა ყელი მინის წვერს. 30 წამი ინსტრუქციის კრიტერიუმია.\"}],\"unknown_parts\":[]}",
