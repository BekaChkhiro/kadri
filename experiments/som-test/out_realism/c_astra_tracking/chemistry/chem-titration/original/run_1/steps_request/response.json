      "content": [
        {
          "annotations": [],
          "text": "{\n  \"steps\": [\n    {\n      \"title\": \"შეავსე ბიურეტი\",\n      \"text\": \"ონკანი დახურულია? ძაბრით ჩაასხი ტიტრანტი ნულოვან ნიშნულზე ოდნავ მაღლა.\",\n      \"focus\": [\"p5\", \"p1\", \"p3\"],\n      \"avoid\": [\"p2\"],\n      \"markers\": [],\n      \"arrows\": [],\n      \"tools\": [\"ტიტრანტი\", \"დამცავი სათვალე\", \"შესაფერისი დამცავი ხელთათმანები\"],\n      \"warn\": \"ფოტოდან ონკანის დახურული მდგომარეობა და ნულოვანი ნიშნული ვერ დასტურდება; შევსებამდე გადაამოწმე.\"\n    },\n    {\n      \"title\": \"მოხსენი ძაბრი\",\n      \"text\": \"ძაბრი ტიტრაციამდე აუცილებლად მოხსენი. მისგან ჩამოსული წვეთები მოცულობას გააფუჭებს.\",\n      \"focus\": [\"p1\"],\n      \"avoid\": [\"p2\"],\n      \"markers\": [],\n      \"arrows\": [\n        {\"part\": \"p1\", \"type\": \"move\", \"dir\": \"up\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"ძაბრი ფრთხილად ამოიღე ისე, რომ ბიურეტი არ შეარყიო და დამჭერი არ მოადუნო.\"\n    },\n    {\n      \"title\": \"წაიკითხე საწყისი მოცულობა\",\n      \"text\": \"თვალი სითხის დონეზე დაიჭირე და წაიკითხე მენისკის ქვედა კიდე. ჩაიწერე ჟურნალში.\",\n      \"focus\": [\"p3\"],\n      \"avoid\": [\"p5\"],\n      \"markers\": [],\n      \"arrows\": [],\n      \"tools\": [\"ჟურნალი\", \"კალამი\"],\n      \"warn\": \"ფოტოზე მენისკი და სკალის მნიშვნელობები საკმარისად მკაფიო არ არის; მოცულობა უშუალოდ ბიურეტზე წაიკითხე.\"\n    },\n    {\n      \"title\": \"დაამატე ინდიკატორი\",\n      \"text\": \"კოლბაში ჩააწვეთე 2–3 წვეთი ფენოლფთალეინი და დადე თეთრ ფილაზე ონკანის ქვეშ.\",\n      \"focus\": [\"p8\", \"p7\", \"p9\"],\n      \"avoid\": [\"p6\"],\n      \"markers\": [],\n      \"arrows\": [],\n      \"tools\": [\"ფენოლფთალეინის ხსნარი\"],\n      \"warn\": \"p8 მდებარეობითა და საწვეთური ფორმით ინდიკატორის სავარაუდო ბოთლია, თუმცა მისი შიგთავსი ფოტოდან არ დასტურდება — გადაამოწმე ეტიკეტი. 2–3 წვეთი მოცემული ინსტრუქციის დოზაა და არა ფოტოდან დადგენილი.\"\n    },\n    {\n      \"title\": \"ტიტრაცია\",\n      \"text\": \"ონკანი ნელა გახსენი და კოლბა წრიულად ატრიალე. გაჩერდი, როცა ღია ვარდისფერი 30 წამს შენარჩუნდება.\",\n      \"focus\": [\"p5\", \"p7\"],\n      \"avoid\": [\"p2\", \"p6\"],\n      \"markers\": [],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"ონკანის გასახსნელად ბრუნვის მიმართულება ფოტოდან არ დასტურდება. ბოლო წერტილთან ტიტრანტი წვეთობით დაამატე; კოლბა მინის წვერს არ მიარტყა. მითითებული ფერი და 30 წამი გამოიყენე მხოლოდ შესაბამისი ტიტრაციის მეთოდიკის ფარგლებში.\"\n    }\n  ],\n  \"unknown_parts\": [\n    \"ტიტრანტის შესანახი ან ჩასასხმელი ჭურჭელი ფოტოზე არ ჩანს.\",\n    \"ჟურნალი, კალამი და დამცავი აღჭურვილობა ფოტოზე არ ჩანს.\"\n  ]\n}",
