      "content": [
        {
          "annotations": [],
          "text": "{\n  \"steps\": [\n    {\n      \"title\": \"ჩართე განათება\",\n      \"text\": \"დააჭირე ჩამრთველს ფუძეზე. შუქი მაგიდის ქვემოდან უნდა ანთოს.\",\n      \"focus\": [\"p12\"],\n      \"avoid\": [],\n      \"markers\": [{\"part\": \"p12\", \"label\": \"ჩამრთველი\", \"tone\": \"brand\"}],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": null\n    },\n    {\n      \"title\": \"დააყენე 4× ობიექტივი\",\n      \"text\": \"მოატრიალე რევოლვერი, სანამ ყველაზე მოკლე ობიექტივი ქვემოთ არ დადგება და არ დაიწკაპუნებს.\",\n      \"focus\": [\"p2\", \"p3\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p2\", \"label\": \"მოატრიალე რევოლვერი\", \"tone\": \"brand\"},\n        {\"part\": \"p3\", \"label\": \"ყველაზე მოკლე ხილული ობიექტივი\", \"tone\": \"neutral\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"მდებარეობისა და სიგრძის მიხედვით ყველაზე სავარაუდო სამიზნეა p3, თუმცა მისი ყვითელი რგოლი ჩვეულებრივ 10×-ს აღნიშნავს. ფოტოზე 4× წარწერა არ იკითხება; გამოყენებამდე გადაამოწმე ობიექტივის გადიდება.\"\n    },\n    {\n      \"title\": \"დადე პრეპარატი\",\n      \"text\": \"მინა დადე მაგიდაზე ისე, რომ ნიმუში ზუსტად ნახვრეტის თავზე იყოს, და ორივე სამაგრით დაამაგრე.\",\n      \"focus\": [\"p7\", \"p8\", \"p5\", \"p6\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p7\", \"label\": \"პრეპარატის მინა\", \"tone\": \"brand\"},\n        {\"part\": \"p5\", \"label\": \"მარჯვენა სამაგრი\", \"tone\": \"brand\"},\n        {\"part\": \"p6\", \"label\": \"მარცხენა სამაგრი\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"მინა ფრთხილად დაამაგრე; ობიექტივი მინას არ უნდა შეეხოს.\"\n    },\n    {\n      \"title\": \"იპოვე გამოსახულება\",\n      \"text\": \"ოკულარში იყურე და დიდი ხრახნი ნელა ატრიალე, სანამ გამოსახულება არ გამოჩნდება.\",\n      \"focus\": [\"p1\", \"p10\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p1\", \"label\": \"ოკულარი\", \"tone\": \"brand\"},\n        {\"part\": \"p10\", \"label\": \"დიდი ფოკუსირების ხრახნი\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"დიდი ხრახნი გამოიყენე მხოლოდ დაბალ გადიდებაზე. გვერდიდან გადაამოწმე დაშორება, რათა ობიექტივი მინას არ დაეჯახოს.\"\n    },\n    {\n      \"title\": \"გადადი 40×-ზე\",\n      \"text\": \"ჩართე 40× ობიექტივი და სიმკვეთრე მხოლოდ პატარა ხრახნით დაარეგულირე, ნახევარი ბრუნით.\",\n      \"focus\": [\"p2\", \"p4\", \"p9\"],\n      \"avoid\": [\"p10\"],\n      \"markers\": [\n        {\"part\": \"p4\", \"label\": \"სავარაუდო 40× — გადაამოწმე წარწერა\", \"tone\": \"neutral\"},\n        {\"part\": \"p9\", \"label\": \"პატარა ფოკუსირების ხრახნი\", \"tone\": \"brand\"},\n        {\"part\": \"p10\", \"label\": \"არ შეეხო\", \"tone\": \"danger\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"ქვემოთ მიმართული გრძელი ობიექტივი p4 ყველაზე სავარაუდო კანდიდატია, თუმცა 40× წარწერა ფოტოზე არ დასტურდება. გადაამოწმე მარკირება. ნახევარი ბრუნი მოცემული ინსტრუქციის მითითებაა და არა ფოტოდან დადგენილი საჭიროება; ატრიალე მცირე მონაკვეთებით და შეჩერდი სიმკვეთრის მიღებისთანავე.\"\n    }\n  ],\n  \"unknown_parts\": []\n}",
