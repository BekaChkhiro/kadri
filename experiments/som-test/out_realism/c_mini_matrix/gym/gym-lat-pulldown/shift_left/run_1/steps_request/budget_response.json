          "text": "{\"steps\":[{\"title\":\"დაარეგულირე სიმაღლე\",\"text\":\"გამოსწიე ყვითელი ღილაკი სავარძლის ქვეშ და ისე დააყენე, რომ ჯდომისას მუხლები ბალიშების ქვეშ მჭიდროდ მოექცეს.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"ყვითელი ქინძისთავი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"move\",\"dir\":\"toward\"}],\"tools\":[],\"warn\":\"გაურკვევლობაა: ფოტოზე მკაფიოდ ჩანს ყვითელი ქინძისთავი, მაგრამ ზუსტად თუ ეს არის სავარძლის ქვეშ არსებული რეგულატორი, ბოლომდე ვერ დადასტურდება; ამიტომ ყველაზე სავარაუდო ID ავირჩიე.\"},{\"title\":\"აირჩიე წონა\",\"text\":\"ყვითელი ქინძისთავი გადაიტანე სასურველ ფილაში და ბოლომდე ჩაარჭე.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"ყვითელი ქინძისთავი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"move\",\"dir\":\"right\"}],\"tools\":[],\"warn\":null},{\"title\":\"მოკიდე სახელურს\",\"text\":\"ფეხზე მდგომმა მოკიდე ხელი მოხრილ ბოლოებთან, მხრებზე ოდნავ ფართოდ, ხელისგულები წინ.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ზედა მოხრილი სახელური\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"toward\"}],\"tools\":[],\"warn\":null},{\"title\":\"დაჯექი და დაფიქსირდი\",\"text\":\"სახელურით ხელში დაჯექი, ფეხები იატაკზე, მუხლები ბალიშების ქვეშ. მკერდი წინ, ზურგი სწორი.\",\"focus\":[\"p6\",\"p4\",\"p5\",\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p6\",\"label\":\"სავარძელი\",\"tone\":\"brand\"},{\"part\":\"p4\",\"label\":\"მარცხენა ბარძაყის ბალიში\",\"tone\":\"brand\"},{\"part\":\"p5\",\"label\":\"მარჯვენა ბარძაყის ბალიში\",\"tone\":\"brand\"},{\"part\":\"p1\",\"label\":\"ზედა მოხრილი სახელური\",\"tone\":\"neutral\"}],\"arrows\":[{\"part\":\"p6\",\"type\":\"move\",\"dir\":\"down\"},{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"toward\"}],\"tools\":[],\"warn\":null},{\"title\":\"ჩამოწიე მკერდამდე\",\"text\":\"იდაყვები ქვემოთ და უკან, სახელური მკერდის ზედა ნაწილამდე. ზემოთ ნელა აუშვი, 2 წა