          "text": "{\"steps\":[{\"title\":\"დაარეგულირე სიმაღლე\",\"text\":\"გამოსწიე ყვითელი ღილაკი სავარძლის ქვეშ და ისე დააყენე, რომ ჯდომისას მუხლები ბალიშების ქვეშ მჭიდროდ მოექცეს.\",\"focus\":[\"p7\"],\"avoid\":[],\"markers\":[{\"part\":\"p7\",\"label\":\"რეგულირების ღილაკი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p7\",\"type\":\"move\",\"dir\":\"toward\"}],\"tools\":[],\"warn\":null},{\"title\":\"აირჩიე წონა\",\"text\":\"ყვითელი ქინძისთავი გადაიტანე სასურველ ფილაში და ბოლომდე ჩაარჭე.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"ქინძისთავი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"move\",\"dir\":\"toward\"}],\"tools\":[],\"warn\":null},{\"title\":\"მოკიდე სახელურს\",\"text\":\"ფეხზე მდგომმა მოკიდე ხელი მოხრილ ბოლოებთან, მხრებზე ოდნავ ფართოდ, ხელისგულები წინ.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ზედა მოხრილი სახელური\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"toward\"}],\"tools\":[],\"warn\":null},{\"title\":\"დაჯექი და დაფიქსირდი\",\"text\":\"სახელურით ხელში დაჯექი, ფეხები იატაკზე, მუხლები ბალიშების ქვეშ. მკერდი წინ, ზურგი სწორი.\",\"focus\":[\"p4\",\"p5\",\"p6\"],\"avoid\":[],\"markers\":[{\"part\":\"p4\",\"label\":\"მარცხენა ბარძაყის საყრდენი\",\"tone\":\"neutral\"},{\"part\":\"p5\",\"label\":\"მარჯვენა ბარძაყის საყრდენი\",\"tone\":\"neutral\"},{\"part\":\"p6\",\"label\":\"სავარძელი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p6\",\"type\":\"move\",\"dir\":\"down\"}],\"tools\":[],\"warn\":\"სამიზნე ზონად რამდენიმე ნაწილი ჩანს; სავარძელი და ორივე ბალიშიანი საყრდენი ერთად გამოიყენება დასაფიქსირებლად.\"},{\"title\":\"ჩამოწიე მკერდამდე\",\"text\":\"იდაყვები ქვემოთ და უკან, სახელური მკერდის ზედა ნაწილამდე. ზემოთ ნელა აუშვი, 2 წამში.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"სახელური\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"down\"}],\"tools\":[],\"warn\":null