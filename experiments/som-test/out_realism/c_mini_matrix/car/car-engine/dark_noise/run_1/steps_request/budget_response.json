          "text": "{\"steps\":[{\"title\":\"იპოვე ზეთის საზომი\",\"text\":\"ყვითელი რგოლი ძრავის საფარის ქვემოთ არის ზეთის საზომი ღერო.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ზეთის საზომი\",\"tone\":\"brand\"}],\"arrows\":[],\"tools\":[],\"warn\":null},{\"title\":\"ამოიღე და გაწმინდე\",\"text\":\"ამოსწიე ღერო ბოლომდე, მშრალი ხელსახოცით გაწმინდე და ისევ ბოლომდე ჩადე.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ღერო\",\"tone\":\"neutral\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"up\"}],\"tools\":[\"მშრალი ხელსახოცი\"],\"warn\":null},{\"title\":\"წაიკითხე დონე\",\"text\":\"კიდევ ერთხელ ამოიღე. ზეთის კვალი ორ ნიშნულს შორის უნდა იყოს.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"საზომი ღერო\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"up\"}],\"tools\":[],\"warn\":null},{\"title\":\"დაამატე ზეთი\",\"text\":\"თუ დონე MIN-თან ახლოსაა, მოხსენი ეს ხუფი საათის ისრის საწინააღმდეგოდ და ჩაასხი 200 მლ, შემდეგ გადაამოწმე.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ზეთის შემავსებელი ხუფი ფოტოზე ჩანს, მაგრამ parts სიაში მისთვის ID არ არის მითითებული; ამიტომ ზუსტ ID-ს ვერ მივუთითებ. მოცემული რაოდენობა ფოტოდან დადასტურებულად არ მიიჩნევა.\"},{\"title\":\"დახურე და გადაამოწმე\",\"text\":\"ხუფი მოუჭირე ბოლომდე, საზომი ღერო ჩადე თავის ადგილას. 2 წუთის შემდეგ კიდევ ერთხელ შეამოწმე დონე.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"საზომი ღერო\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"down\"}],\"tools\":[],\"warn\":\"ხუფზე მოქმედება კვლავ ასრულდება დაუზუსტებელი ID-ის გარეშე; აქ ფოკუსი მხოლოდ ნაჩვენებ ზეთის საზომ ღეროზეა მიბმული.\"}],\"unknown_parts\":[\"ზეთის შემავსებელი ხუფი (parts სიაში ID არ აქვს)\"]}",
