          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"იპოვე ზეთის საზომი\",\"text\":\"ყვითელი რგოლი ძრავის საფარის ქვემოთ. ეს არის ზეთის საზომი ღერო.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"ზეთის საზომი ღერო\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"move\",\"dir\":\"up\"}],\"tools\":[],\"warn\":null},{\"title\":\"ამოიღე და გაწმინდე\",\"text\":\"ამოსწიე ღერო ბოლომდე, მშრალი ხელსახოცით გაწმინდე და ისევ ბოლომდე ჩადე.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"ზეთის საზომი ღერო\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"move\",\"dir\":\"up\"}],\"tools\":[\"მშრალი ხელსახოცი\"],\"warn\":null},{\"title\":\"წაიკითხე დონე\",\"text\":\"კიდევ ერთხელ ამოიღე. ზეთის კვალი ორ ნიშნულს შორის უნდა იყოს.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"ზეთის საზომი ღერო\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"move\",\"dir\":\"up\"}],\"tools\":[],\"warn\":null},{\"title\":\"დაამატე ზეთი\",\"text\":\"თუ დონე MIN-თან ახლოსაა, მოხსენი ეს ხუფი საათის ისრის საწინააღმდეგოდ და ჩაასხი 200 მლ, შემდეგ გადაამოწმე.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ძრავის ზეთის შესავსები ხუფი\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[\"ზეთი\"],\"warn\":\"ხუფის ზუსტი მოქმედი სამიზნე ფოტოზე ჩანს, მაგრამ ინსტრუქცია მხოლოდ MIN-თან ახლო დონის შემთხვევაში ითხოვს მის მოხსნას; დოზა ფოტოდან ვერ დადასტურდება და 200 მლ მოცემულია მხოლოდ ინსტრუქციის მიხედვით.\"},{\"title\":\"დახურე და გადაამოწმე\",\"text\":\"ხუფი მოუჭირე ბოლომდე, საზომი ღერო ჩადე თავის ადგილას. 2 წუთის შემდეგ კიდევ ერთხელ შეამოწმე დონე.\",\"focus\":[\"p1\",\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ძრავის ზეთის შესავსები ხუფი\",\"tone\":\"brand\"},{\"part\":\"p2\",\"label\":\"ზეთის საზომი ღერო\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p2\",\"type\":\"move\",\"dir\":\"down\"}],\"tools\":[],\"warn\":null}],\"unknown_parts\":[]}",
