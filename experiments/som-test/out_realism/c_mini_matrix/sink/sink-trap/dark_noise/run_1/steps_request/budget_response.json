          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ონკნები/ჩამკეტები ამ ნაწილების სიაში არ არის; ფოტოზე ცალკე ID-ით მონიშნული სამიზნე არ ჩანს, ამიტომ focus ცარიელია.\"},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ვედრო/თასი ფოტოზე არ ჩანს, ამიტომ მისთვის ID არ არსებობს. ცარიელი ადგილი არ უნდა ავიღოთ ID-ად.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ქანჩი\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[],\"warn\":\"ყველაზე სავარაუდო სამიზნე ზედა მარცხენა შემაერთებელი ქანჩია (p1); იგი ჩანს და მდებარეობითაც შეესაბამება ინსტრუქციას.\"},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"შუასადების/ქანჩის ადგილი\",\"tone\":\"neutral\"}],\"arrows\":[],\"tools\":[],\"warn\":\"შუასადები თვითონ ფოტოზე არ ჩანს; ჩანს მხოლოდ ქანჩის ადგილი (p1). ამიტომ focus p1-ზეა, ხოლო რეალური რგოლის მდგომარეობა ამ ფოტოდან დადასტურებით ვერ ჩანს.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ქანჩი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":\"სამიზნე კვლავ p1-ია. ფოტოზე წყლის გაშვების/ჟონვის შემდგომი მდგომარეობა არ ჩანს, ამიტომ შემოწმების ნაწილი მხოლოდ ინსტრუქციულია.\"}],\"unknown_parts\":[\"ონკნები/წყლის ჩამკეტები\",\"ვედრო ან ღრმა თასი\",\"შუასადები (რეზინის რგოლი)\"]}",
