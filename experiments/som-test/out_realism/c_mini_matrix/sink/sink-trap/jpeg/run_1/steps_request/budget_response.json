          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[\"p1\",\"p2\"],\"avoid\":[],\"markers\":[],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p2\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":null},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[\"p4\",\"p3\",\"p1\",\"p2\"],\"markers\":[],\"arrows\":[],\"tools\":[\"ვედრო ან ღრმა თასი\"],\"warn\":\"ვედრო/თასი ფოტოზე არ ჩანს, ამიტომ focus ცარიელია. არ გამოიყენო ფონის ან ცარიელი ადგილის ID.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p3\"],\"avoid\":[\"p4\"],\"markers\":[],\"arrows\":[{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[],\"warn\":null},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p3\"],\"avoid\":[\"p4\"],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"შუასადები თავად ფოტოზე არ ჩანს; ჩანს მხოლოდ მის ადგილამდე მისასვლელი ქანჩი. ზომა ფოტოდან დადასტურებული არ არის, ამიტომ ეს მხოლოდ ინსტრუქციული დაშვებაა.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p3\"],\"avoid\":[\"p1\",\"p2\",\"p4\"],\"markers\":[],\"arrows\":[{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":\"გახსნის/შემოწმებისას ნაკადი და გაჟონვა ფოტოზე არ ჩანს; ეს ნაბიჯი შესრულების შემდგომი დაკვირვებაა.\"}],\"unknown_parts\":[\"ვედრო ან ღრმა თასი\",\"შუასადები (რეზინის რგოლი)\"]}",
