          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[\"p3\",\"p4\"],\"avoid\":[],\"markers\":[{\"part\":\"p3\",\"label\":\"დაკეტე\",\"tone\":\"neutral\"},{\"part\":\"p4\",\"label\":\"დაკეტე\",\"tone\":\"neutral\"}],\"arrows\":[{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p4\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":null},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[\"p1\",\"p2\",\"p3\",\"p4\"],\"markers\":[],\"arrows\":[],\"tools\":[\"ვედრო ან ღრმა თასი\"],\"warn\":\"ვედრო/თასი ფოტოზე არ ჩანს, ამიტომ სამიზნე ნაწილი მიუთითებელი დარჩა. ცარიელი ადგილი ან ფონის ნაწილი არ გამოვიყენე.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"ქანჩი\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[],\"warn\":\"ქანჩი მთავარი ვერტიკალური შეერთებაა; ფოტოში მის ირგვლივ რამდენიმე მსგავსი თეთრი რგოლი ჩანს, მაგრამ მოქმედების სამიზნედ ყველაზე სავარაუდოდ p2 მივიჩნიე.\"},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"შეამოწმე შუასადები\",\"tone\":\"neutral\"}],\"arrows\":[],\"tools\":[],\"warn\":\"შუასადები ფოტოზე პირდაპირ არ ჩანს; შემოწმება უნდა მოხდეს p2-ის შიგნით მოხსნის შემდეგ. ზომა ფოტოდან არ დადასტურდება.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p2\",\"p3\",\"p4\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"მოუჭირე\",\"tone\":\"brand\"},{\"part\":\"p3\",\"label\":\"გახსენი და დააკვირდი\",\"tone\":\"neutral\"},{\"part\":\"p4\",\"label\":\"გახსენი და დააკვირდი\",\"tone\":\"neutral\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p4\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":\"დაკვირვებისას გაჟონვის ხილული კვალი შეიძლება p2-ის შეერთებაზე გამოჩნდეს, მაგრამ ფოტოდან ეს წინასწარ არ დასტურდება. ამიტომ მონიტორინგი p2-ზე და წყლის კონტროლი p3/p4-ზე მივუთითე.\"}],\"unknown_parts\":[\"ვედრო ან ღრმა თასი\"]}",
