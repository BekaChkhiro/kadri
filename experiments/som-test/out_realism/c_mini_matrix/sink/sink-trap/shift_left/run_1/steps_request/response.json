          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ონკანი ამ ფოტოზე სამიზნე ნაწილების სიაში არ ჩანს, ამიტომ კონკრეტული ID არ მიუთითებია.\"},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ვედრო ან ღრმა თასი ფოტოზე არ ჩანს, ამიტომ empty focus დავტოვე. დასადგმელი ზონის ID არ გამოვიყენე.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ქანჩი/შეერთება\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[],\"warn\":\"ქანჩი p1-ის მარჯვენა შეერთებაზეა; ფოტოზე სხვა მსგავსი შეერთება არ ჩანს.\"},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"შუასადების/შეერთების ადგილი\",\"tone\":\"neutral\"}],\"arrows\":[],\"tools\":[],\"warn\":\"შუასადები ფოტოზე პირდაპირ არ ჩანს; აქედან მხოლოდ p1-ის შეერთების ზონა იგულისხმება.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ქანჩი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":\"ფოტოზე წვეთები ჩანს მარჯვენა შეერთებასთან, ამიტომ სწორედ ამ წერტილზეა შემოწმება ყველაზე სავარაუდო.\"}],\"unknown_parts\":[\"ონკანი\",\"ვედრო ან ღრმა თასი\"]}",
          "type": "output_text",
          "logprobs": []
        }
