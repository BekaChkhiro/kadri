          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ონკანი ფოტოზე არ ჩანს; ამიტომ კონკრეტული ნაწილი/ID ვერ განისაზღვრა.\"},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[\"ვედრო\"],\"warn\":\"ვედრო ფოტოზე არ ჩანს; ცარიელი focus განზრახ დატოვებულია.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p3\"],\"avoid\":[],\"markers\":[{\"part\":\"p3\",\"label\":\"მარჯვენა თეთრი ქანჩი\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[],\"warn\":\"ქანჩი ორი ჩანს (ზედა და მარჯვენა); ჟონვის ხილული კვალი არ ჩანს, ამიტომ ყველაზე სავარაუდოდ მარჯვენა ქანჩი (p3) ავირჩიე მისი მდებარეობისა და ინსტრუქციის მიხედვით.\"},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p3\"],\"avoid\":[],\"markers\":[{\"part\":\"p3\",\"label\":\"მარჯვენა თეთრი ქანჩი\",\"tone\":\"neutral\"}],\"arrows\":[],\"tools\":[],\"warn\":\"შუასადები ფოტოზე არ ჩანს; ამიტომ შემოწმება უნდა შესრულდეს ქანჩის მოხსნის შემდეგ.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p3\"],\"avoid\":[],\"markers\":[{\"part\":\"p3\",\"label\":\"მარჯვენა თეთრი ქანჩი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":\"მოვუჭერელი/მოშვებული მდგომარეობა ფოტოზე არ ჩანს; p3 ავირჩიე როგორც ყველაზე სავარაუდო დასამუშავებელი ქანჩი.\"}],\"unknown_parts\":[\"ონკანი\",\"ვედრო\",\"შუასადები\"]}",
