          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"დაკეტე ორივე სარქველი\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[\"ხელები\"],\"warn\":\"ფოტოზე ჩანს ორი მეტალის სარქველი და შლანგი; აქედან ვგულისხმობ p1-ს, რადგან სხვა ონკანი არ ჩანს.\"},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[\"p1\",\"p2\",\"p3\",\"p4\",\"p5\"],\"markers\":[],\"arrows\":[],\"tools\":[\"ვედრო ან ღრმა თასი\"],\"warn\":\"ვედრო/ღრმა თასი ფოტოზე არ ჩანს, ამიტომ focus ცარიელია. დასადგმელი ნივთის ID-ის მინიჭება შეუძლებელია.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p4\"],\"avoid\":[\"p1\",\"p2\",\"p3\",\"p5\"],\"markers\":[{\"part\":\"p4\",\"label\":\"ჟონვის სავარაუდო ადგილი\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p4\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[\"ხელები\"],\"warn\":\"ხილული წვეთები და ნესტიანი კვალი ყველაზე მეტად p4-ის შეერთებასთან ჩანს; p5-ის ნაცვლად p4 ავირჩიე, რადგან მარჯვენა კედლისკენ მიმავალი კავშირი უფრო სავარაუდო სამიზნეა.\"},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p4\"],\"avoid\":[\"p1\",\"p2\",\"p3\",\"p5\"],\"markers\":[{\"part\":\"p4\",\"label\":\"გახსენადი შეერთება\",\"tone\":\"neutral\"}],\"arrows\":[{\"part\":\"p4\",\"type\":\"move\",\"dir\":\"away\"}],\"tools\":[\"ხელები\",\"სათადარიგო შუასადები\"],\"warn\":\"შუასადები ფოტოზე პირდაპირ არ ჩანს; აქ მითითებული focus არის ის შეერთება, სადაც მისი შემოწმება უნდა მოხდეს, არა თავად რგოლი. ზომა ფოტოდან ვერ დასტურდება.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p4\"],\"avoid\":[\"p1\",\"p2\",\"p3\",\"p5\"],\"markers\":[{\"part\":\"p4\",\"label\":\"საბოლოო შემოწმება\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p4\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[\"ხელები\"],\"warn\":\"მეოთხედი ბრუნი და გაშვების შემდეგი დაკვირვება მხოლოდ ინსტრუქციული შეფასებაა; ფოტოდან დადასტურებული არ არის.\"}],\"unknown_parts\":[\"ვედრო ან ღრმა თასი\",\"რეზინის შუასადები (ფოტოზე არ ჩანს პირდაპირ)\"]}",
