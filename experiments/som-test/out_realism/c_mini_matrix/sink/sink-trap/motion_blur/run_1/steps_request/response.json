          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ონკანი ამ ფოტოში არ ჩანს, ამიტომ მიზნობრივ ID-ს ვერ ვუთითებ. მოქმედება ეხება უხილავ ნაწილს.\"},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ვედრო/დასადგმელი ნივთი ფოტოში არ ჩანს, ამიტომ focus ცარიელია. ფონის ან ცარიელი ადგილის ID-ის გამოყენება არ არის სწორი.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ყველაზე სავარაუდო სამიზნე არის p2, რადგან ხილული ქანჩი/შეერთება სწორედ სიფონის მთავარ თეთრ ნაწილზე ჩანს. თუმცა ფოტოს სიშორისა და დაბინდვის გამო მცირე გაურკვევლობა რჩება p3-თან შედარებით.\"},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"შუასადების შემოწმება უკავშირდება p2-ზე მდებარე ქანჩს/შეერთებას. რეზინის რგოლი ფოტოში პირდაპირ არ ჩანს, ამიტომ დაშვებაა საჭირო.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p2\"],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"სამიზნე ისევ p2-ია, რადგან დამჭერი ქანჩი და მთავარი მოსაჭერი შეერთება იქ ჩანს. შემდგომი გაჟონვის დადასტურება ფოტოდან ვერ ხდება.\"}],\"unknown_parts\":[\"ონკანი\",\"ვედრო\"]}",
