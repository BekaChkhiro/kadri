          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[\"p2\",\"p3\"],\"avoid\":[],\"markers\":[{\"part\":\"p2\",\"label\":\"დაკეტე\",\"tone\":\"danger\"},{\"part\":\"p3\",\"label\":\"დაკეტე\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p2\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":null},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ვედრო ან ღრმა თასი ფოტოზე არ ჩანს, ამიტომ სამიზნე დასადგმელი ნივთისთვის focus ცარიელია. უცნობია, რომელი კონკრეტული კონტეინერია ხელმისაწვდომი, ამიტომ არ ვანიშნებ IDs-ს.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"ქანჩი\",\"tone\":\"danger\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[\"ხელები\"],\"warn\":\"საწვდენი ადგილი/ჟონვის ზუსტი წერტილი ფოტოზე მკაფიოდ არ ჩანს, მაგრამ ყველაზე სავარაუდო სამიზნე სიფონის ქანჩია.\"},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"შუასადები/ქანჩი\",\"tone\":\"neutral\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"down\"}],\"tools\":[\"ხელები\"],\"warn\":\"შუასადები ფოტოზე არ ჩანს, ამიტომ მხოლოდ სიფონის ქანჩის ნაწილზე ვანიშნებ. ზომა ფოტოდან დადასტურებული არ არის.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p1\",\"p2\",\"p3\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"მოუჭირე\",\"tone\":\"brand\"},{\"part\":\"p2\",\"label\":\"გახსენი\",\"tone\":\"neutral\"},{\"part\":\"p3\",\"label\":\"გახსენი\",\"tone\":\"neutral\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p2\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[\"ხელები\"],\"warn\":\"ონკანების გახსნა ფოტოზე მხოლოდ სავარაუდო ნაბიჯია; წყლის გაშვებისას რეალური გაჟონვის შემოწმება უნდა მოხდეს ადგილზე.\"}],\"unknown_parts\":[\"ვედრო/ღრმა თასი\"]}",
