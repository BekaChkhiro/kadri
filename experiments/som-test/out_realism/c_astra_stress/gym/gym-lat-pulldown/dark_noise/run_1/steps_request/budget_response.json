          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაარეგულირე სიმაღლე\",\"text\":\"გამოსწიე ყვითელი ღილაკი სავარძლის ქვეშ და ისე დააყენე, რომ ჯდომისას მუხლები ბალიშების ქვეშ მჭიდროდ მოექცეს.\",\"focus\":[\"p7\",\"p6\"],\"avoid\":[],\"markers\":[{\"part\":\"p7\",\"label\":\"სიმაღლის რეგულირების ღილაკი\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p7\",\"type\":\"move\",\"dir\":\"toward\"}],\"tools\":[],\"warn\":\"სამიზნედ არჩეულია სავარძლის ქვეშ მდებარე p7 და არა წონის დასტასთან არსებული ყვითელი ქინძისთავი. რეგულირება გააკეთე დაუტვირთავ სავარძელზე და დაჯდომამდე დარწმუნდი, რომ მექანიზმი ჩაიკეტა.\"},{\"title\":\"აირჩიე წონა\",\"text\":\"ყვითელი ქინძისთავი გადაიტანე სასურველ ფილაში და ბოლომდე ჩაარჭე.\",\"focus\":[\"p2\"],\"avoid\":[\"p3\"],\"markers\":[{\"part\":\"p2\",\"label\":\"წონის ასარჩევი ქინძისთავი\",\"tone\":\"brand\"},{\"part\":\"p3\",\"label\":\"თითები ფილებს შორის არ მოათავსო\",\"tone\":\"danger\"}],\"arrows\":[],\"tools\":[],\"warn\":\"წონა შეცვალე მხოლოდ მაშინ, როცა ფილების დასტა სრულად დაშვებულია და არ მოძრაობს. ფოტოდან წონის მნიშვნელობა არ დასტურდება.\"},{\"title\":\"მოკიდე სახელურს\",\"text\":\"ფეხზე მდგომმა მოკიდე ხელი მოხრილ ბოლოებთან, მხრებზე ოდნავ ფართოდ, ხელისგულები წინ.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p1\",\"label\":\"მოჭიდება მოხრილ ბოლოებთან\",\"tone\":\"brand\"}],\"arrows\":[],\"tools\":[],\"warn\":\"სახელურს ნახტომით ნუ მისწვდები; თუ უსაფრთხოდ ვერ სწვდები, დახმარება სთხოვე დარბაზის თანამშრომელს.\"},{\"title\":\"დაჯექი და დაფიქსირდი\",\"text\":\"სახელურით ხელში დაჯექი, ფეხები იატაკზე, მუხლები ბალიშების ქვეშ. მკერდი წინ, ზურგი სწორი.\",\"focus\":[\"p6\",\"p4\",\"p5\",\"p1\"],\"avoid\":[],\"markers\":[{\"part\":\"p6\",\"label\":\"სავარძელი\",\"tone\":\"brand\"},{\"part\":\"p4\",\"label\":\"მარცხენა დამჭერი ბალიში\",\"tone\":\"brand\"},{\"part\":\"p5\",\"label\":\"მარჯვენა დამჭერი ბალიში\",\"tone\":\"brand\"}],\"arrows\":[],\"tools\":[],\"warn\":\"ბალიშებმა ბარძაყები მუხლებთან ახლოს მყარად, მაგრამ უმტკივნეულოდ უნდა დააფიქსიროს.\"},{\"title\":\"ჩამოწიე მკერდამდე\",\"text\":\"იდაყვები ქვემოთ და უკან, სახელური მკერდის ზედა ნაწილამდე. ზემოთ ნელა აუშვი, 2 წამში.\",\"focus\":[\"p1\"],\"avoid\":[\"p3\"],\"markers\":[{\"part\":\"p1\",\"label\":\"ჩამოწიე კონტროლირებულად\",\"tone\":\"brand\"}],\"arrows\":[{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"down\"},{\"part\":\"p1\",\"type\":\"move\",\"dir\":\"up\"}],\"tools\":[],\"warn\":\"სახელური კისრის უკან არ ჩამოწიო და ტანი არ გააქნიო. ტკივილის შემთხვევაში შეწყვიტე მოძრაობა; ფილები ერთმანეთს არ დაარტყა.\"}],\"unknown_parts\":[]}",
