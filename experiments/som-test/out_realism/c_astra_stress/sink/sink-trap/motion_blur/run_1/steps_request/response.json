      "id": "msg_03a0f92fb1e0c175016ad35d29502087d2966ba53d4622e0c9",
      "content": [
        {
          "annotations": [],
          "text": "{\n  \"steps\": [\n    {\n      \"title\": \"დაკეტე წყალი\",\n      \"text\": \"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\n      \"focus\": [\"p2\", \"p3\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p2\", \"label\": \"პირველი ონკანი\", \"tone\": \"brand\"},\n        {\"part\": \"p3\", \"label\": \"მეორე ონკანი\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [\n        {\"part\": \"p2\", \"type\": \"rotate\", \"dir\": \"cw\"},\n        {\"part\": \"p3\", \"type\": \"rotate\", \"dir\": \"cw\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"ონკანები ძალით არ გადაატრიალო.\"\n    },\n    {\n      \"title\": \"ჩადგი ვედრო სიფონის ქვეშ\",\n      \"text\": \"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\n      \"focus\": [],\n      \"avoid\": [],\n      \"markers\": [],\n      \"arrows\": [],\n      \"tools\": [\"ვედრო ან ღრმა თასი\"],\n      \"warn\": \"დასადგმელი ვედრო ან თასი ფოტოზე არ ჩანს და მინიჭებული ID არ აქვს.\"\n    },\n    {\n      \"title\": \"მოუშვი ქანჩი\",\n      \"text\": \"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\n      \"focus\": [\"p4\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p4\", \"label\": \"სავარაუდო სამიზნე ქანჩი\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [\n        {\"part\": \"p4\", \"type\": \"rotate\", \"dir\": \"ccw\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"ფოტო ბუნდოვანია; წვეთები ან სველი კვალი მკაფიოდ არ ჩანს. სამუშაო დაშვებით არჩეულია p4 — სიფონისა და კედლისკენ მიმავალი მილის შეერთების ქანჩი; p1-იც შესაძლო კანდიდატია. გახსნამდე გადაამოწმე გაჟონვის ადგილი.\"\n    },\n    {\n      \"title\": \"შეამოწმე შუასადები\",\n      \"text\": \"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\n      \"focus\": [\"p5\", \"p4\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p5\", \"label\": \"მოსახსნელი სიფონი\", \"tone\": \"brand\"},\n        {\"part\": \"p4\", \"label\": \"შუასადები ქანჩის შიგნით\", \"tone\": \"neutral\"}\n      ],\n      \"arrows\": [],\n      \"tools\": [\"შესაბამისი ზომის ახალი შუასადები, საჭიროების შემთხვევაში\"],\n      \"warn\": \"რეზინის რგოლი შიგნითაა და ფოტოზე არ ჩანს; p4 წინა ნაბიჯის დაშვებითაა მითითებული. 40 მმ მოცემული ინსტრუქციის ზომაა და ფოტოთი არ დასტურდება — შეცვლამდე გადაამოწმე. სიფონს მოხსნისას ხელი შეაშველე.\"\n    },\n    {\n      \"title\": \"მოუჭირე და შეამოწმე\",\n      \"text\": \"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\n      \"focus\": [\"p4\", \"p2\", \"p3\"],\n      \"avoid\": [],\n      \"markers\": [\n        {\"part\": \"p4\", \"label\": \"მოუჭირე და შეამოწმე შეერთება\", \"tone\": \"brand\"}\n      ],\n      \"arrows\": [\n        {\"part\": \"p4\", \"type\": \"rotate\", \"dir\": \"cw\"},\n        {\"part\": \"p2\", \"type\": \"rotate\", \"dir\": \"ccw\"},\n        {\"part\": \"p3\", \"type\": \"rotate\", \"dir\": \"ccw\"}\n      ],\n      \"tools\": [],\n      \"warn\": \"p4 მითითებულია იმავე დაუდასტურებელი დაშვებით. პლასტმასს ზედმეტად ნუ მოუჭერ: დამატებითი მეოთხედი ბრუნი არ გამოიყენო ძალით ან მწარმოებლის მითითების საწინააღმდეგოდ. შემოწმებისთვის ნიჟარის ონკანიდან წყალიც გაუშვი.\"\n    }\n  ],\n  \"unknown_parts\": [\n    \"ვედრო ან ღრმა თასი — ფოტოზე არ ჩანს.\",\n    \"ქანჩის შიდა რეზინის შუასადები — გარედან უხილავია.\",\n    \"ნიჟარის ონკანი — ფოტოზე არ ჩანს.\"\n  ]\n}",
          "type": "output_text",
          "logprobs": []
        }
      ],
