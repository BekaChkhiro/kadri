          "annotations": [],
          "text": "{\n  \"object\": \"თვალის მოძრაობის კვლევის სამუშაო სადგური\",\n  \"parts\": [\n    {\n      \"id\": \"chin_rest\",\n      \"label\": \"ნიკაპის საყრდენი\",\n      \"box\": [111, 308, 400, 365]\n    },\n    {\n      \"id\": \"height_adjustment_knob\",\n      \"label\": \"ნიკაპის საყრდენის სიმაღლის მარეგულირებელი ბორბალი\",\n      \"box\": [147, 462, 265, 521]\n    },\n    {\n      \"id\": \"forehead_rest\",\n      \"label\": \"შუბლის საყრდენი\",\n      \"box\": [84, 90, 439, 159]\n    },\n    {\n      \"id\": \"monitor_screen\",\n      \"label\": \"მონიტორის ეკრანი\",\n      \"box\": [194, 118, 943, 367]\n    },\n    {\n      \"id\": \"eye_tracker\",\n      \"label\": \"თვალის მოძრაობის სენსორი ეკრანის ქვემოთ\",\n      \"box\": [305, 374, 844, 409]\n    },\n    {\n      \"id\": \"screen_dot\",\n      \"label\": \"ეკრანზე ხილული შავი წერტილი\",\n      \"box\": [543, 246, 556, 253]\n    },\n    {\n      \"id\": \"response_pad\",\n      \"label\": \"პასუხის პულტი\",\n      \"box\": [783, 475, 992, 544]\n    },\n    {\n      \"id\": \"red_button\",\n      \"label\": \"პულტის წითელი ღილაკი\",\n      \"box\": [820, 485, 871, 504]\n    },\n    {\n      \"id\": \"blue_button\",\n      \"label\": \"პულტის ლურჯი ღილაკი\",\n      \"box\": [905, 488, 958, 508]\n    }\n  ],\n  \"steps\": [\n    {\n      \"title\": \"ნიკაპის საყრდენის სიმაღლე\",\n      \"text\": \"ხრახნით ისე დააყენე, რომ მონაწილის თვალები ეკრანის ზედა მესამედის დონეზე იყოს და კომფორტულად იჯდეს.\",\n      \"focus\": [\n        \"height_adjustment_knob\",\n        \"chin_rest\",\n        \"monitor_screen\"\n      ],\n      \"avoid\": [],\n      \"markers\": [\n        {\n          \"part\": \"height_adjustment_knob\",\n          \"label\": \"სიმაღლის რეგულირება\",\n          \"tone\": \"brand\"\n        },\n        {\n          \"part\": \"chin_rest\",\n          \"label\": \"ნიკაპის საყრდენი\",\n          \"tone\": \"neutral\"\n        }\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"ბორბლის ბრუნვის საჭირო მიმართულება ფოტოდან არ დგინდება. მონაწილე არ ჩანს, ამიტომ თვალების დონე და კომფორტული პოზა ვერ მოწმდება. ზედა მესამედთან გასწორება ინსტრუქციის პირობაა და არა ფოტოდან დადასტურებული მდგომარეობა. ეს კვლევითი აღწერაა და არა პროფესიული რჩევა.\"\n    },\n    {\n      \"title\": \"შუბლის საყრდენი\",\n      \"text\": \"შუბლი მსუბუქად უნდა ეხებოდეს საყრდენს. ასე თავი ექსპერიმენტის განმავლობაში უძრავი რჩება.\",\n      \"focus\": [\n        \"forehead_rest\"\n      ],\n      \"avoid\": [],\n      \"markers\": [\n        {\n          \"part\": \"forehead_rest\",\n          \"label\": \"შუბლის შეხების ზედაპირი\",\n          \"tone\": \"brand\"\n        }\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"შუბლის საყრდენი ჩანს, მაგრამ მონაწილე არ ჩანს; შეხების სიმსუბუქე და თავის უძრაობა ფოტოდან ვერ დასტურდება.\"\n    },\n    {\n      \"title\": \"შეამოწმე eye-tracker\",\n      \"text\": \"სენსორი ეკრანის ქვედა კიდეზეა და მონაწილის თვალებისკენ უნდა იყურებოდეს.\",\n      \"focus\": [\n        \"eye_tracker\"\n      ],\n      \"avoid\": [],\n      \"markers\": [\n        {\n          \"part\": \"eye_tracker\",\n          \"label\": \"სენსორი ეკრანის ქვემოთ\",\n          \"tone\": \"brand\"\n        }\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"სენსორი ჩანს, მაგრამ მონაწილის თვალები არ ჩანს; მათკენ მიმართვა და სენსორის გამართული მუშაობა ფოტოდან ვერ მოწმდება. სივრცული მიმართულება ეკრანზე მოძრაობის ისრით არ არის აღნიშნული.\"\n    },\n    {\n      \"title\": \"კალიბრაცია\",\n      \"text\": \"მონაწილე თვალს აყოლებს წერტილს 9 პოზიციაზე და თავს არ ამოძრავებს. ცუდ შედეგზე გაიმეორე.\",\n      \"focus\": [],\n      \"avoid\": [],\n      \"markers\": [\n        {\n          \"part\": \"screen_dot\",\n          \"label\": \"ხილულია მხოლოდ ერთი წერტილი\",\n          \"tone\": \"neutral\"\n        }\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"ხილული წერტილის კალიბრაციის წერტილად დანიშნულება დაუდასტურებელია, ხოლო კალიბრაციის მართვისა და შედეგების შეფასების ელემენტები არ ჩანს; ამიტომ ფოკუსი ცარიელია. 9 პოზიცია ინსტრუქციის პირობაა და არა ფოტოდან დადასტურებული მონაცემი.\"\n    },\n    {\n      \"title\": \"პასუხის პულტი\",\n      \"text\": \"აუხსენი ღილაკები და გააკეთე სავარჯიშო ცდა. ინსტრუქცია ყველა მონაწილეს ერთნაირად წაუკითხე.\",\n      \"focus\": [\n        \"response_pad\",\n        \"red_button\",\n        \"blue_button\"\n      ],\n      \"avoid\": [],\n      \"markers\": [\n        {\n          \"part\": \"red_button\",\n          \"label\": \"წითელი ღილაკი\",\n          \"tone\": \"brand\"\n        },\n        {\n          \"part\": \"blue_button\",\n          \"label\": \"ლურჯი ღილაკი\",\n          \"tone\": \"brand\"\n        }\n      ],\n      \"arrows\": [],\n      \"tools\": [],\n      \"warn\": \"ორივე ღილაკი ჩანს, მაგრამ პასუხებთან მათი შესაბამისობა ფოტოზე მითითებული არ არის; ფერების მიხედვით ფუნქციები არ უნდა ვივარაუდოთ.\"\n    }\n  ],\n  \"unknown_parts\": [\n    \"მონაწილის თვალები და შუბლი — მონაწილე ფოტოზე არ ჩანს.\",\n    \"კალიბრაციის გაშვების, გამეორებისა და შედეგების შეფასების პროგრამული ელემენტები — ფოტოზე არ ჩანს.\",\n    \"კალიბრაციის ცხრა სამიზნე პოზიცია — სრული მიმდევრობა არ ჩანს; ეკრანზე მხოლოდ ერთი შავი წერტილია, რომლის დანიშნულებაც დაუდასტურებელია.\"\n  ]\n}",
          "type": "output_text",
