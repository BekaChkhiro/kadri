          "annotations": [],
          "text": "{\"steps\":[{\"title\":\"დაკეტე წყალი\",\"text\":\"მოატრიალე ონკანი საათის ისრის მიმართულებით ბოლომდე. შემდეგ მეორეც დაკეტე.\",\"focus\":[\"p2\",\"p3\"],\"avoid\":[],\"markers\":[],\"arrows\":[{\"part\":\"p2\",\"type\":\"rotate\",\"dir\":\"cw\"},{\"part\":\"p3\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":null},{\"title\":\"ჩადგი ვედრო სიფონის ქვეშ\",\"text\":\"სიფონში წყალი დგას. გახსნისას ჩამოიღვრება, ამიტომ ვედრო ან ღრმა თასი პირდაპირ მის ქვეშ დადგი.\",\"focus\":[],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"ვედრო/ღრმა თასი ფოტოზე არ ჩანს, ამიტომ ფოკუსი ცარიელია. დასადგმელი ადგილი ასევე არ არის ცალკე მონიშნული.\"},{\"title\":\"მოუშვი ქანჩი\",\"text\":\"ეს ქანჩი ჟონავს. ხელით მოუშვი საათის ისრის საწინააღმდეგოდ. პლასტმასისაა, გასაღები არ დაგჭირდება.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"ccw\"}],\"tools\":[],\"warn\":\"სავარაუდო სამიზნე არის სიფონის ხილული ქანჩი; სხვა შესატყვისი ნაწილი არ ჩანს.\"},{\"title\":\"შეამოწმე შუასადები\",\"text\":\"მოხსენი სიფონი და ნახე ქანჩის შიგნით რეზინის რგოლი. თუ დაბზარულია ან გვერდზეა გადაწეული, შეცვალე. ზომა: 40 მმ.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[],\"arrows\":[],\"tools\":[],\"warn\":\"შუასადები ფოტოზე პირდაპირ არ ჩანს; მხოლოდ სიფონის ქანჩის არეა ჩანს, ამიტომ შემოწმება დაშვებაზეა დაფუძნებული.\"},{\"title\":\"მოუჭირე და შეამოწმე\",\"text\":\"ხელით მოუჭირე ბოლომდე, შემდეგ კიდევ მეოთხედი ბრუნი. გახსენი წყალი და ერთი წუთი დააკვირდი.\",\"focus\":[\"p1\"],\"avoid\":[],\"markers\":[],\"arrows\":[{\"part\":\"p1\",\"type\":\"rotate\",\"dir\":\"cw\"}],\"tools\":[],\"warn\":\"სავარაუდოდ იგულისხმება იგივე ხილული სიფონის ქანჩი; ფოტოზე წყლის გაშვება და გაჟონვის ტესტი ვერ დადასტურდება.\"}],\"unknown_parts\":[\"ვედრო/ღრმა თასი\"]}",
